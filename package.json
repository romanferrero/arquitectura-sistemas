{
  "name": "portafolio-cripto",
  "version": "1.0.0",
  "description": "API REST para gestionar un portafolio de criptoactivos",
  "type": "module",
  "main": "dist/servidor.js",
  "scripts": {
    "dev": "node --env-file=.env --watch src/servidor.ts",
    "build": "tsc",
    "start": "node --env-file=.env dist/servidor.js",
    "check": "tsc --noEmit -p tsconfig.check.json",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js"
  },
  "keywords": [
    "api",
    "rest",
    "express",
    "typescript",
    "cripto"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "express": "^5.2.1",
    "winston": "^3.19.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^26.4.0",
    "jest": "^30.5.2",
    "typescript": "^7.0.2"
  }
}
