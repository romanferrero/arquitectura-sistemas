# Puerto en el que escucha la API
PORT=3000

# Entorno de ejecucion (development | production)
NODE_ENV=development

# API externa de precios (CoinGecko - no requiere API key)
API_PRECIOS_URL=https://api.coingecko.com/api/v3/simple/price

# Moneda en la que se expresan los precios
MONEDA=usd

# Timeout en milisegundos para la llamada a la API externa
TIMEOUT_MS=5000

# API externa de tipo de cambio (open.er-api.com - no requiere API key).
# Se consulta como <URL>/<MONEDA> y devuelve cuanto vale 1 MONEDA en USD.
API_TASAS_URL=https://open.er-api.com/v6/latest

# Analisis de riesgo (POST /api/activos/analizar): un activo es high_risk si
# su monto (cantidad x precioCompra, en USD) SUPERA el umbral (Whale Alert)
# o si su volatilidad informada (en %) SUPERA el umbral de volatilidad.
UMBRAL_MONTO_USD=100000
UMBRAL_VOLATILIDAD=80
